# Copy this file to .env and fill in your values, then run:
#   docker compose up
# or, to re-run without recreating the container:
#   docker compose run --rm reolink-downloader
#
# This is a one-off job: the container downloads everything in the
# configured date range, then exits. Edit REOLINK_START_TIME/REOLINK_END_TIME
# (or override with `docker compose run --rm reolink-downloader --start-time ... --end-time ...`)
# and re-run it each time you want a new batch.

# --- Optional: which code the container runs. Defaults to this repo's main
# branch (always the latest); override to pin to a release or point at a fork. ---
REPO_URL=https://github.com/harvy4002/reolink-downloader.git
REPO_REF=main

# --- Required ---
REOLINK_IP=192.168.1.100
REOLINK_USERNAME=admin
REOLINK_PASSWORD=changeme
REOLINK_START_TIME=2024-01-01
REOLINK_END_TIME=2024-01-02

# --- Optional ---
# Channel(s) to download: 'all' (default), a single index, a comma list,
# a range, or a combination — e.g. '0', '0,2,5', '0-3', '0,2-4,7'.
REOLINK_CHANNEL=all

# Concurrent Baichuan download connections (default: 3). Reolink PoE NVRs
# support at most 4 concurrent playback streams.
REOLINK_CONCURRENCY=3

# wide, telephoto, or both (default: both). Only matters for cameras/channels
# with a second (telephoto) lens; ignored elsewhere.
REOLINK_LENS=both

# Cap on total recordings downloaded across all selected channels (leave
# blank to download everything found).
REOLINK_LIMIT=

# Print the raw Baichuan protocol exchange for diagnosing downloads.
REOLINK_DEBUG=false

# NOTE: do not set REOLINK_OUTPUT here — the Dockerfile fixes it to
# /downloads, which docker-compose.yml bind-mounts to ./downloads on the
# host. Change the host side of that mount in docker-compose.yml instead.

# --- Optional: Telegram notifications ---
# Both must be set for notifications to be sent; leave both blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
